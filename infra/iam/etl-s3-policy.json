{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPipelinePrefixesOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::luxury-explorers-bookings-gimsara",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["raw/*", "processed/*", "rejected/*"]
        }
      }
    },
    {
      "Sid": "ReadWritePipelineObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::luxury-explorers-bookings-gimsara/raw/*",
        "arn:aws:s3:::luxury-explorers-bookings-gimsara/processed/*",
        "arn:aws:s3:::luxury-explorers-bookings-gimsara/rejected/*"
      ]
    }
  ]
}
