# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.

# PostgreSQL (used by docker-compose.yml and the pipeline)
PGHOST=localhost
PGPORT=5433
PGDATABASE=hotel_bookings
PGUSER=etl_user
PGPASSWORD=change_me

# Pipeline input
RAW_DATA_PATH=data/raw/hotel_bookings_raw.csv

# AWS S3 (leave S3_BUCKET empty to skip the uploads).
# Use the access key of the dedicated least-privilege IAM user (infra/iam/etl-s3-policy.json),
# never root or admin credentials. boto3 reads these variables directly.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET=
